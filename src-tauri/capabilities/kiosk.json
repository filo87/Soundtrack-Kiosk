{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "kiosk",
  "description": "Single-window kiosk capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "allow-ping",
    "allow-search-tracks",
    "allow-prefetch-cover",
    "allow-prepare-selection",
    "allow-discard-preparation",
    "allow-commit-selection",
    "allow-admin-unlock",
    "allow-admin-lock",
    "allow-admin-status",
    "allow-auth-start",
    "allow-auth-logout",
    "allow-get-public-config",
    "allow-get-config",
    "allow-set-config",
    "allow-list-printers",
    "allow-test-print",
    "allow-list-recent",
    "allow-reprint",
    "allow-export-csv",
    "allow-clear-history",
    "allow-mark-refilled",
    "allow-reset-printer-counters",
    "allow-set-maintenance",
    "allow-exit-kiosk"
  ]
}
